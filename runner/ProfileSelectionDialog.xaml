<Window x:Class="FreeAiSsd.Runner.ProfileSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Your Profile"
        Height="500" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgBaseBrush}">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Choose your default profile"
                       Style="{StaticResource H1Text}"/>
            <TextBlock Text="You can switch profiles at any time from the main window."
                       Style="{StaticResource BodySecondaryText}"/>
        </StackPanel>

        <!-- Profile cards -->
        <UniformGrid Grid.Row="2" Columns="2" >
            <UniformGrid.Resources>
                <Style TargetType="UniformGrid"/>
            </UniformGrid.Resources>

            <!-- Flight Sim card -->
            <Border x:Name="FlightSimCard"
                    Margin="0,0,8,0"
                    CornerRadius="12"
                    Background="{StaticResource BgRaisedBrush}"
                    BorderBrush="{StaticResource SurfaceBorderBrush}"
                    BorderThickness="2"
                    Cursor="Hand"
                    SnapsToDevicePixels="True"
                    Effect="{StaticResource RaisedDarkShadow}"
                    MouseLeftButtonDown="FlightSimCard_Click"
                    KeyDown="Card_KeyDown"
                    Focusable="True">
                <StackPanel Margin="20" VerticalAlignment="Center">
                    <TextBlock Text="✈"
                               FontSize="36"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12"
                               Foreground="{StaticResource AccentCyanBrush}"/>
                    <TextBlock Text="Flight Sim"
                               Style="{StaticResource H2Text}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,4"/>
                    <StackPanel Margin="0,4,0,0">
                        <TextBlock Style="{StaticResource CaptionText}" TextAlignment="Center" Text="✦  DCS controller bindings import"/>
                        <TextBlock Style="{StaticResource CaptionText}" TextAlignment="Center" Text="✦  HOTAS push-to-talk button" Margin="0,3,0,0"/>
                        <TextBlock Style="{StaticResource CaptionText}" TextAlignment="Center" Text="✦  Whisper STT + TTS voice I/O" Margin="0,3,0,0"/>
                        <TextBlock Style="{StaticResource CaptionText}" TextAlignment="Center" Text="✦  Always-on-top PTT overlay" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- General Assistant card -->
            <Border x:Name="GeneralAssistantCard"
                    Margin="8,0,0,0"
                    CornerRadius="12"
                    Background="{StaticResource BgRaisedBrush}"
                    BorderBrush="{StaticResource SurfaceBorderBrush}"
                    BorderThickness="2"
                    Cursor="Hand"
                    SnapsToDevicePixels="True"
                    Effect="{StaticResource RaisedDarkShadow}"
                    MouseLeftButtonDown="GeneralAssistantCard_Click"
                    KeyDown="Card_KeyDown"
                    Focusable="True">
                <StackPanel Margin="20" VerticalAlignment="Center">
                    <TextBlock Text="◈"
                               FontSize="36"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12"
                               Foreground="{StaticResource AccentMagentaBrush}"/>
                    <TextBlock Text="General Assistant"
                               Style="{StaticResource H2Text}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,4"/>
                    <StackPanel Margin="0,4,0,0">
                        <TextBlock Style="{StaticResource CaptionText}" TextAlignment="Center" Text="✦  RAG-augmented chat"/>
                        <TextBlock Style="{StaticResource CaptionText}" TextAlignment="Center" Text="✦  Whisper STT + TTS voice I/O" Margin="0,3,0,0"/>
                        <TextBlock Style="{StaticResource CaptionText}" TextAlignment="Center" Text="✦  Clean interface, no flight sim panels" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Continue button -->
        <Button x:Name="ContinueButton"
                Grid.Row="4"
                Content="Continue"
                Style="{StaticResource TactilePrimaryButton}"
                HorizontalAlignment="Right"
                IsEnabled="False"
                Click="Continue_Click"/>
    </Grid>
</Window>
