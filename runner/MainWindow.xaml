<Window x:Class="FreeAiSsd.Runner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Free AI SSD Runner" Height="700" Width="980">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Start Ollama" Padding="12,6" Click="Start_Click"/>
            <Button x:Name="UnlockDriveButton" Content="Unlock Drive" Padding="12,6" Margin="8,0,0,0" Click="UnlockDrive_Click" Visibility="Collapsed"/>
            <Button Content="Stop Ollama" Padding="12,6" Margin="8,0,0,0" Click="Stop_Click"/>
            <Button Content="Open Chat UI (browser)" Padding="12,6" Margin="8,0,0,0" Click="OpenBrowser_Click"/>
            <TextBlock x:Name="StatusText" Margin="12,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="System Compatibility" FontWeight="Bold"/>
                <TextBlock x:Name="CompatibilityGpuText" Margin="0,4,0,0"/>
                <TextBlock x:Name="CompatibilityCpuText" Margin="0,2,0,0"/>
                <TextBlock x:Name="CompatibilityOsText" Margin="0,2,0,0"/>
                <TextBlock x:Name="CompatibilityDepsText" Margin="0,2,0,0"/>
                <TextBlock Text="Ollama typically auto-selects best available backend. This app detects hardware for visibility."
                           TextWrapping="Wrap" Foreground="#555" Margin="0,6,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Re-run dependency check" Click="RerunDependencyCheck_Click"/>
                    <Button Content="Open prerequisites folder" Margin="8,0,0,0" Click="OpenPrereqsFolder_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Model:" VerticalAlignment="Center"/>
            <ComboBox x:Name="ModelCombo" Width="220" Margin="8,0,0,0"/>
            <TextBox x:Name="PromptText" Width="450" Margin="8,0,0,0" Text="Say hello from portable SSD."/>
            <Button Content="Send" Margin="8,0,0,0" Click="Send_Click"/>
        </StackPanel>

        <TextBox Grid.Row="3" x:Name="ResponseText" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
        <TextBox Grid.Row="4" x:Name="LogText" Height="140" Margin="0,8,0,0" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
    </Grid>
</Window>
