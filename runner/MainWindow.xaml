<Window x:Class="FreeAiSsd.Runner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:FreeAiSsd.Shared.UI.Theme"
        xmlns:local="clr-namespace:FreeAiSsd.Runner"
        Title="Free AI SSD Runner" Height="1020" Width="1100"
        Background="{StaticResource BgBaseBrush}"
        ToolTipService.InitialShowDelay="400"
        ToolTipService.BetweenShowDelay="200"
        ToolTipService.ShowDuration="15000">

    <Window.Resources>
        <local:EmptyToVisibilityConverter x:Key="EmptyToVisibilityConverter"/>
        <local:FileSizeConverter x:Key="FileSizeConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!--  ────────────────────────────────────────────────────────
              TactileMagentaButton
              Magenta-gradient variant of TactilePrimaryButton used for
              destructive / stop-style primary actions.
              ────────────────────────────────────────────────────────  -->
        <Style x:Key="TactileMagentaButton" TargetType="{x:Type Button}">
            <Setter Property="FontFamily" Value="{StaticResource PrimaryFontFamily}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid>
                            <Border x:Name="Surface"
                                    CornerRadius="10"
                                    Background="{StaticResource NeonHotGradientBrush}"
                                    BorderBrush="{StaticResource SurfaceBorderBrush}"
                                    BorderThickness="1"
                                    Effect="{StaticResource RaisedDarkShadow}">
                                <ContentPresenter x:Name="Content"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush"
                                        Value="{StaticResource AccentMagentaBrush}"/>
                                <Setter TargetName="Surface" Property="Effect"
                                        Value="{StaticResource FocusGlowMagenta}"/>
                            </Trigger>
                            <!-- Keyboard focus: magenta border + glow so
                                 tab-navigating users get the same affordance. -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush"
                                        Value="{StaticResource AccentMagentaBrush}"/>
                                <Setter TargetName="Surface" Property="Effect"
                                        Value="{StaticResource FocusGlowMagenta}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Effect"
                                        Value="{StaticResource SunkenDarkShadow}"/>
                                <Setter TargetName="Content" Property="RenderTransform"
                                        Value="{DynamicResource ButtonPressTransform}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground"
                                        Value="{StaticResource TextDisabledBrush}"/>
                                <Setter TargetName="Surface" Property="Opacity" Value="0.55"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ────────────────────────────────────────────────────────
              SegmentedGameButton
              Inner button inside the game-selector segmented control.
              Set Tag="Selected" on the active segment to render the
              sunken surface + cyan-gradient underline.

              Also reused by the top-level tab strip (Chat / Voice /
              Sim / System) — same affordance: active segment has the
              sunken surface + cyan underline.
              ────────────────────────────────────────────────────────  -->
        <Style x:Key="SegmentedGameButton" TargetType="{x:Type Button}">
            <Setter Property="FontFamily" Value="{StaticResource PrimaryFontFamily}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="MinWidth" Value="160"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid>
                            <Border x:Name="Surface"
                                    CornerRadius="8"
                                    Background="Transparent"/>
                            <Border x:Name="Underline"
                                    Height="2" VerticalAlignment="Bottom"
                                    Margin="14,0,14,3"
                                    CornerRadius="1"
                                    Background="{StaticResource NeonGradientBrush}"
                                    Effect="{StaticResource HoverGlowCyan}"
                                    Visibility="Collapsed"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter TargetName="Surface" Property="Background"
                                        Value="{StaticResource BgSunkenBrush}"/>
                                <Setter TargetName="Surface" Property="Effect"
                                        Value="{StaticResource SunkenDarkShadow}"/>
                                <Setter TargetName="Underline" Property="Visibility"
                                        Value="Visible"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground"
                                        Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <!-- Keyboard focus: reveal the cyan underline so
                                 tab users can tell which segment they're on. -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Underline" Property="Visibility"
                                        Value="Visible"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground"
                                        Value="{StaticResource TextDisabledBrush}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ────────────────────────────────────────────────────────
              PillRadioButton
              RadioButton rendered as a rounded pill segment. Checked =
              neon cyan→magenta gradient background; unchecked = empty
              pill with hover border.
              ────────────────────────────────────────────────────────  -->
        <Style x:Key="PillRadioButton" TargetType="{x:Type RadioButton}">
            <Setter Property="FontFamily" Value="{StaticResource PrimaryFontFamily}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="Pill"
                                CornerRadius="14"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Background"
                                        Value="{StaticResource NeonGradientBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="BorderBrush"
                                        Value="{StaticResource AccentCyanBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <!-- Keyboard focus: gradient border so tab users
                                 can tell which pill they're on. -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Pill" Property="BorderBrush"
                                        Value="{StaticResource FocusBorderGradientBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ListBox / ListView skin for the dark theme: transparent
              surface sitting inside a sunken parent card.  -->
        <Style x:Key="ThemedListBox" TargetType="{x:Type ListBox}">
            <Setter Property="Background" Value="{StaticResource BgSunkenBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
    </Window.Resources>

    <!-- Root: main content + FTUE overlay layered on top. -->
    <Grid>
    <ScrollViewer x:Name="RootScroll"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
    <!-- ═══════════════════════════════════════════════════════════════
         RootContent: tab header strip + four sibling tab grids.

         Mac-parity initiative #44 stage 1 — a Grid-based "tab" shell
         (not a WPF TabControl) so every named control stays in the
         visual tree regardless of which tab is active. This keeps the
         existing code-behind's x:Name references intact while moving
         the cards into the right tab groupings (RECONSTRUCTION §4 +
         §6, owner-confirmed: separate tabs Chat / Voice / Sim /
         System).

         Stage 2 will reorder the Chat tab to Mac §B1 calm-layout
         (banners, sources list, etc.); stage 1 is structural only.
         ═══════════════════════════════════════════════════════════════ -->
    <Grid x:Name="RootContent" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- Tab header strip                                            -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Margin="0,0,0,10"
                HorizontalAlignment="Left"
                CornerRadius="10"
                Background="{StaticResource RaisedSurfaceGradientBrush}"
                BorderBrush="{StaticResource SurfaceBorderBrush}"
                BorderThickness="1"
                Padding="4"
                Effect="{StaticResource RaisedDarkShadowSmall}">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="TabChatButton"
                        Content="Chat"
                        Style="{StaticResource SegmentedGameButton}"
                        Tag="Selected"
                        Click="TabChat_Click"
                        ToolTip="Chat with the model, manage RAG document libraries."/>
                <Button x:Name="TabVoiceButton"
                        Content="Voice"
                        Style="{StaticResource SegmentedGameButton}"
                        Click="TabVoice_Click"
                        ToolTip="Speech output (TTS) and input (STT) settings; Push-to-Talk in the Flight Sim profile."/>
                <Button x:Name="TabSimButton"
                        Content="Sim"
                        Style="{StaticResource SegmentedGameButton}"
                        Click="TabSim_Click"
                        ToolTip="Flight-sim controller binding import. Available with the Flight Sim profile."/>
                <Button x:Name="TabSystemButton"
                        Content="System"
                        Style="{StaticResource SegmentedGameButton}"
                        Click="TabSystem_Click"
                        ToolTip="Hardware compatibility, prerequisites, and dependencies."/>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- Tab body host: four overlapping grids, exactly one Visible. -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" x:Name="TabHost">

            <!-- ─────────────────────── Chat tab ─────────────────────── -->
            <!-- Row order (top→bottom) is intentional — Mac-parity §B1:
                 top controls → model+prompt → reference docs →
                 outcome banners → response → sources → log.
                 Banners and sources are conditional (Collapsed unless the
                 most recent Send produced that signal). -->
            <Grid x:Name="ChatTab">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 0: top controls    -->
                    <RowDefinition Height="Auto"/> <!-- 1: model + prompt  -->
                    <RowDefinition Height="Auto"/> <!-- 2: reference docs  -->
                    <RowDefinition Height="Auto"/> <!-- 3: outcome banners -->
                    <RowDefinition Height="Auto"/> <!-- 4: response        -->
                    <RowDefinition Height="Auto"/> <!-- 5: sources         -->
                    <RowDefinition Height="Auto"/> <!-- 6: log + advanced  -->
                </Grid.RowDefinitions>

                <!-- Chat / Row 0: Top Controls -->
                <Border x:Name="TopControlsCard" Grid.Row="0" Style="{StaticResource NeumorphicCard}" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="StartOllamaButton" Content="Start Ollama"
                                Style="{StaticResource TactileMagentaButton}"
                                Click="Start_Click"
                                ToolTip="Launch the local Ollama server from this SSD."/>
                        <Button x:Name="UnlockDriveButton" Content="Unlock Drive"
                                Style="{StaticResource GhostSecondaryButton}"
                                Margin="10,0,0,0"
                                Click="UnlockDrive_Click"
                                Visibility="Collapsed"
                                ToolTip="Decrypt the portable config with your passphrase."/>
                        <Button x:Name="StopOllamaButton" Content="Stop Ollama"
                                Style="{StaticResource GhostSecondaryButton}"
                                Margin="10,0,0,0"
                                Click="Stop_Click"
                                ToolTip="Stop the running Ollama server process."/>
                        <Button Content="Open Chat UI (browser)"
                                Style="{StaticResource TactilePrimaryButton}"
                                Margin="10,0,0,0"
                                Click="OpenBrowser_Click"
                                ToolTip="Open the local Ollama chat web UI in your default browser."/>

                        <StackPanel Orientation="Horizontal" Margin="16,0,0,0"
                                    VerticalAlignment="Center">
                            <theme:LedStatusIndicator x:Name="OllamaStatusLed"
                                                      State="Idle"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,8,0"
                                                      ToolTip="Ollama server status: idle, busy, ready, or error."/>
                            <TextBlock x:Name="StatusText"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Border Margin="16,0,0,0"
                                CornerRadius="14"
                                Background="{StaticResource BgSunkenBrush}"
                                BorderBrush="{StaticResource SurfaceBorderBrush}"
                                BorderThickness="1"
                                Padding="3"
                                Effect="{StaticResource SunkenDarkShadow}"
                                VerticalAlignment="Center"
                                ToolTip="Switch between Flight Sim and General Assistant profiles.">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ProfileFlightSimPill"
                                             Content="✈ Flight Sim"
                                             Style="{StaticResource PillRadioButton}"
                                             GroupName="ProfilePills"
                                             Checked="ProfilePill_Checked"/>
                                <RadioButton x:Name="ProfileGeneralPill"
                                             Content="◈ General"
                                             Style="{StaticResource PillRadioButton}"
                                             GroupName="ProfilePills"
                                             Checked="ProfilePill_Checked"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Chat / Row 1: Model + Prompt -->
                <Border x:Name="ModelPromptCard" Grid.Row="1" Style="{StaticResource NeumorphicCard}" Margin="0,0,0,10">
                    <Grid>
                        <StackPanel x:Name="ModelPromptRow" Orientation="Horizontal">
                            <TextBlock Text="Model:"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                            <ComboBox x:Name="ModelCombo"
                                      Style="{StaticResource GlowFocusComboBox}"
                                      Width="220" Margin="8,0,0,0"
                                      ToolTip="Pick which installed model handles this prompt."/>
                            <TextBox x:Name="PromptText"
                                     Style="{StaticResource GlowFocusTextBox}"
                                     Width="400" Margin="10,0,0,0"
                                     Text="Say hello from portable SSD."
                                     ToolTip="Type the message to send to the selected model."/>
                            <Button x:Name="SendButton" Content="Send"
                                    Style="{StaticResource TactilePrimaryButton}"
                                    MinWidth="100" Margin="10,0,0,0"
                                    Click="Send_Click"
                                    ToolTip="Send the prompt to the selected model."/>
                            <Button x:Name="StopButton" Content="Stop"
                                    Style="{StaticResource TactileMagentaButton}"
                                    MinWidth="80" Margin="6,0,0,0"
                                    Click="Stop_Generation_Click"
                                    Visibility="Collapsed"
                                    ToolTip="Cancel the current streaming generation."/>
                            <Button x:Name="VoiceButton" Content="🎤 Voice"
                                    Style="{StaticResource TactilePrimaryButton}"
                                    MinWidth="110" Margin="6,0,0,0"
                                    Click="Voice_Click"
                                    ToolTip="Record from the microphone and transcribe with Whisper."/>
                            <TextBlock x:Name="VoiceStatusText"
                                       Margin="10,0,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource AccentCyanBrush}"
                                       Visibility="Collapsed"/>
                            <TextBlock x:Name="StreamingIndicator" Text="● Generating..."
                                       Margin="10,0,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource AccentCyanBrush}"
                                       Visibility="Collapsed"/>
                        </StackPanel>

                        <!-- Empty state: no models installed in the portable config. -->
                        <Border x:Name="NoModelsEmptyState"
                                Background="{StaticResource BgBaseBrush}"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <theme:LedStatusIndicator State="Error"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,10,0"/>
                                <TextBlock Text="Install a model in the Prep app first"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <Button Content="Open Prep app"
                                        Style="{StaticResource GhostSecondaryButton}"
                                        Tag="{StaticResource AccentCyanBrush}"
                                        Margin="14,0,0,0"
                                        Click="OpenPrepApp_Click"
                                        ToolTip="Launch the Free AI SSD Prep app to download a starter model."/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Chat / Row 2: Reference Documents -->
                <Border x:Name="ReferenceDocsCard" Grid.Row="2" Style="{StaticResource NeumorphicCard}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Reference Documents" Style="{StaticResource H2Text}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Library:"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                            <ComboBox x:Name="LibraryCombo"
                                      Style="{StaticResource GlowFocusComboBox}"
                                      Width="250" Margin="8,0,0,0"
                                      SelectionChanged="LibraryCombo_SelectionChanged"
                                      ToolTip="Pick which document library answers reference-grounded prompts."/>
                            <TextBox x:Name="NewLibraryNameText"
                                     Style="{StaticResource GlowFocusTextBox}"
                                     Width="220" Margin="10,0,0,0"
                                     Text="My library"
                                     ToolTip="Display name for a new library you're about to create."/>
                            <Button x:Name="CreateLibraryButton"
                                    Content="Create library"
                                    Style="{StaticResource GhostSecondaryButton}"
                                    Tag="{StaticResource AccentCyanBrush}"
                                    Margin="10,0,0,0"
                                    Click="CreateLibrary_Click"
                                    ToolTip="Create a new empty document library with the typed name."/>
                            <Button x:Name="RenameLibraryButton"
                                    Content="Rename"
                                    Style="{StaticResource GhostSecondaryButton}"
                                    Margin="10,0,0,0"
                                    Click="RenameLibrary_Click"
                                    ToolTip="Rename the selected library."/>
                            <Button x:Name="DeleteLibraryButton"
                                    Content="Delete"
                                    Style="{StaticResource GhostSecondaryButton}"
                                    Margin="10,0,0,0"
                                    Click="DeleteLibrary_Click"
                                    ToolTip="Delete the selected library and all its indexed files."/>
                        </StackPanel>
                        <!-- Library management surface — Mac-parity §B2:
                             gate the whole block behind "library is selected".
                             When nothing is active, show one hint line instead
                             of six disabled buttons, a collapsed Index-tools
                             expander, and an empty files list. Visibility of
                             this section vs NoLibraryEmptyState is owned by
                             UpdateNoLibraryEmptyState() in code-behind. -->
                        <StackPanel x:Name="LibraryManagementSection" Visibility="Collapsed">
                            <WrapPanel Margin="0,10,0,0">
                                <Button x:Name="AddFilesButton" Content="Add files"
                                        Style="{StaticResource GhostSecondaryButton}"
                                        Margin="0,0,8,8" Click="AddFiles_Click"
                                        ToolTip="Add one or more files to the active library."/>
                                <Button x:Name="AddFolderButton" Content="Add folder"
                                        Style="{StaticResource GhostSecondaryButton}"
                                        Margin="0,0,8,8" Click="AddFolder_Click"
                                        ToolTip="Watch a folder; new and changed files are swept on demand."/>
                                <Button Content="Remove selected file"
                                        Style="{StaticResource GhostSecondaryButton}"
                                        Margin="0,0,0,8" Click="RemoveFile_Click"
                                        ToolTip="Remove the highlighted file from the active library."/>
                            </WrapPanel>

                            <Expander x:Name="IndexToolsExpander"
                                      Header="Index tools"
                                      Style="{StaticResource NeumorphicExpander}"
                                      IsExpanded="False"
                                      Margin="0,2,0,0"
                                      ToolTip="Maintenance actions for the embedding index.">
                                <WrapPanel>
                                    <Button Content="Rebuild index"
                                            Style="{StaticResource GhostSecondaryButton}"
                                            Margin="0,0,8,8" Click="RebuildIndex_Click"
                                            ToolTip="Re-embed every file in the active library from scratch."/>
                                    <Button Content="Pull embedding model"
                                            Style="{StaticResource GhostSecondaryButton}"
                                            Margin="0,0,8,8" Click="PullEmbeddingModel_Click"
                                            ToolTip="Download the configured embedding model via the running Ollama server."/>
                                    <Button Content="Sweep folders now"
                                            Style="{StaticResource GhostSecondaryButton}"
                                            Margin="0,0,0,8" Click="SweepFolders_Click"
                                            ToolTip="Re-scan all watched folders and ingest any new or changed files."/>
                                </WrapPanel>
                            </Expander>

                            <TextBlock x:Name="IndexingStatusText"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,8,0,0"/>
                            <!-- #4 indexing transparency: determinate progress bar +
                                 time-remaining estimate, driven by the per-chunk
                                 IndexingProgress callback. Collapsed when idle; shown
                                 while an ingest/sweep/rebuild runs. -->
                            <Grid x:Name="IndexingProgressPanel"
                                  Margin="0,6,0,0"
                                  Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ProgressBar x:Name="IndexingProgressBar"
                                             Grid.Column="0"
                                             Height="6"
                                             Minimum="0" Maximum="100" Value="0"
                                             VerticalAlignment="Center"/>
                                <TextBlock x:Name="IndexingEtaText"
                                           Grid.Column="1"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <!-- Cancel the in-flight ingest/sweep/rebuild. Visible only
                                     while the panel is shown; wired to RunIndexingAsync's token. -->
                                <Button x:Name="IndexingCancelButton"
                                        Grid.Column="2"
                                        Content="Cancel"
                                        Style="{StaticResource GhostSecondaryButton}"
                                        Margin="10,0,0,0"
                                        Padding="10,2"
                                        VerticalAlignment="Center"
                                        Click="CancelIndexing_Click"
                                        ToolTip="Stop the current indexing run. Chunks already written are kept."/>
                            </Grid>
                            <!-- Workstream C: proactive embedding-model readiness.
                                 UpdateEmbeddingModelHint() shows this when a library
                                 is active but the configured embedder isn't installed,
                                 so the user pulls it before an ingest fails. The Pull
                                 action reuses the Index-tools handler. -->
                            <Border x:Name="EmbeddingModelHint"
                                    Style="{StaticResource WarningBanner}"
                                    Margin="0,8,0,0"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock x:Name="EmbeddingModelHintText"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextWrapping="Wrap"/>
                                    <Button Content="Pull embedding model"
                                            Style="{StaticResource GhostSecondaryButton}"
                                            HorizontalAlignment="Left"
                                            Margin="0,8,0,0"
                                            Click="PullEmbeddingModel_Click"
                                            ToolTip="Download the configured embedding model via the running Ollama server."/>
                                </StackPanel>
                            </Border>
                            <!-- Files indexed in the active library. Sources cited by the
                                 most recent answer live in their own headlined block at
                                 Row 5 of ChatTab (Mac §B1). Workstream D1: each row now
                                 shows size + imported date (already on DocumentFileEntry).
                                 ItemsSource stays a List<DocumentFileEntry> so the Remove
                                 handler's SelectedItem cast keeps working. -->
                            <ListBox x:Name="LibraryFilesList"
                                     Style="{StaticResource ThemedListBox}"
                                     Height="90"
                                     Margin="0,10,0,0"
                                     ToolTip="Files currently indexed in the active library.">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding FileName}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Grid.Column="1"
                                                       Margin="12,0,0,0"
                                                       Style="{StaticResource CaptionText}"
                                                       Foreground="{StaticResource TextSecondaryBrush}">
                                                <Run Text="{Binding SizeBytes, Converter={StaticResource FileSizeConverter}, Mode=OneWay}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding ImportedAtUtc, StringFormat='yyyy-MM-dd', Mode=OneWay}"/>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Workstream D1: watched folders (read-only). manifest.WatchedFolders
                                 was previously surfaced in neither UI. Removal lands in D2.
                                 The whole block hides when there are no watched folders. -->
                            <StackPanel x:Name="WatchedFoldersSection"
                                        Margin="0,10,0,0"
                                        Visibility="Collapsed">
                                <TextBlock Text="Watched folders"
                                           Style="{StaticResource CaptionText}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontWeight="SemiBold"/>
                                <ItemsControl x:Name="WatchedFoldersList"
                                              Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding}"
                                                           VerticalAlignment="Center"
                                                           Style="{StaticResource CaptionText}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <Button Grid.Column="1"
                                                        Content="Remove"
                                                        Margin="8,0,0,0"
                                                        Padding="6,1"
                                                        Style="{StaticResource GhostSecondaryButton}"
                                                        Click="RemoveWatchedFolder_Click"
                                                        ToolTip="Stop watching this folder."/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>

                        <!-- Empty state shown in place of LibraryManagementSection
                             when no library is selected. Workstream C: a short
                             numbered first-run flow instead of one bare line. The
                             Create action lives in the accent-tagged Create row
                             above; step 1 points the user at it. -->
                        <Border x:Name="NoLibraryEmptyState"
                                Margin="0,12,0,4"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Get started:"
                                           Style="{StaticResource CaptionText}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="1. Create a library (name it above, then click Create library)"
                                           Style="{StaticResource CaptionText}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="2. Add files (PDF, TXT, Markdown, JSON, CSV)"
                                           Style="{StaticResource CaptionText}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,2,0,0"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="3. Ask grounded questions in chat"
                                           Style="{StaticResource CaptionText}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,2,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Chat / Row 3: Outcome banners (mutually exclusive).
                     One signal per Send: Failure → red, RagRetrievalFailed
                     → orange, Success → both Collapsed. Driven by
                     SetChatOutcome() in code-behind so mutual exclusion is
                     structural, not by convention. Log entries still write
                     to LogText for scrollback. -->
                <StackPanel Grid.Row="3" x:Name="ChatOutcomeBanners" Margin="0,0,0,10">
                    <Border x:Name="ChatErrorBanner"
                            Style="{StaticResource DangerBanner}"
                            Visibility="Collapsed">
                        <TextBlock x:Name="ChatErrorBannerText"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextWrapping="Wrap"/>
                    </Border>
                    <Border x:Name="RagWarningBanner"
                            Style="{StaticResource WarningBanner}"
                            Visibility="Collapsed">
                        <TextBlock x:Name="RagWarningBannerText"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>

                <!-- Chat / Row 4: Response TextBox (model output) -->
                <TextBox Grid.Row="4" x:Name="ResponseText"
                         Style="{StaticResource GlowFocusTextBox}"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap"
                         MinHeight="300"
                         MaxHeight="500"
                         ToolTip="The model's most recent answer. Streaming output appears here token-by-token."/>

                <!-- Chat / Row 5: Sources from the most recent answer.
                     Collapsed unless ShowSources() found at least one
                     citation on the last result. Lives directly under the
                     response so the user reads answer → citations
                     top-to-bottom, matching Mac §B1. -->
                <Border Grid.Row="5" x:Name="SourcesGroup"
                        Style="{StaticResource NeumorphicCard}"
                        Margin="0,10,0,0"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Sources" Style="{StaticResource H2Text}"/>
                        <ListBox x:Name="SourcesList"
                                 Style="{StaticResource ThemedListBox}"
                                 Height="110"
                                 Margin="0,8,0,0"
                                 ToolTip="Document chunks the model cited in its most recent answer."/>
                    </StackPanel>
                </Border>

                <!-- Chat / Row 6: Bottom Log + Advanced expander (Replay tour). -->
                <Border Grid.Row="6" Style="{StaticResource NeumorphicCard}"
                        Margin="0,10,0,0" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBox x:Name="LogText" Height="140"
                                     AcceptsReturn="True" IsReadOnly="True"
                                     VerticalScrollBarVisibility="Auto"
                                     TextWrapping="Wrap"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{StaticResource AccentCyanBrush}"
                                     FontFamily="{StaticResource MonoFontFamily}"
                                     FontSize="13"
                                     ToolTip="Live log of background activity — Ollama, indexing, voice, PTT.">
                                <TextBox.Resources>
                                    <Style TargetType="{x:Type ScrollViewer}"
                                           BasedOn="{StaticResource SunkenLogViewer}"/>
                                </TextBox.Resources>
                            </TextBox>

                            <!-- Empty state: Ollama is not running. Centered CTA covers the log. -->
                            <Border x:Name="OllamaOfflineEmptyState"
                                    Background="{StaticResource BgBaseBrush}"
                                    Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                                        <theme:LedStatusIndicator State="Idle"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0,0,8,0"/>
                                        <TextBlock Text="Ollama is offline"
                                                   Style="{StaticResource H2Text}"
                                                   Margin="0"/>
                                    </StackPanel>
                                    <TextBlock Text="Start the local server to send prompts and stream responses."
                                               Style="{StaticResource CaptionText}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,12"/>
                                    <Button Content="Start Ollama"
                                            Style="{StaticResource TactilePrimaryButton}"
                                            HorizontalAlignment="Center"
                                            Click="Start_Click"
                                            ToolTip="Launch the local Ollama server from this SSD."/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Expander Grid.Row="1"
                                  Header="Advanced"
                                  Style="{StaticResource NeumorphicExpander}"
                                  IsExpanded="False"
                                  Margin="0,8,0,0"
                                  ToolTip="Less-used actions, such as replaying the guided tour.">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Replay tour"
                                        Style="{StaticResource GhostSecondaryButton}"
                                        Tag="{StaticResource AccentCyanBrush}"
                                        Click="ReplayTour_Click"
                                        ToolTip="Re-show the 4-step guided tour."/>
                            </StackPanel>
                        </Expander>
                    </Grid>
                </Border>
            </Grid>

            <!-- ────────────────────── Voice tab ─────────────────────── -->
            <!-- Three stacked cards, top→bottom — Mac-parity #44 stage 4:
                 Speech output (TTS) and Speech input (STT) are universal
                 (visible in both profiles); Push-to-Talk is Flight-Sim-only
                 and is hidden by RefreshProfileVisibility in General. -->
            <Grid x:Name="VoiceTab" Visibility="Collapsed">
                <StackPanel>

                <!-- Voice / Card 1: Speech output (TTS) -->
                <Border x:Name="VoiceOutputCard" Style="{StaticResource NeumorphicCard}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Speech output"
                                   Style="{StaticResource H2Text}"/>
                        <TextBlock Text="Read the assistant's replies aloud through your speakers."
                                   Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap" Margin="0,4,0,10"/>

                        <!-- Master enable toggle -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <ToggleButton x:Name="TtsEnabledCheck"
                                          Style="{StaticResource NeonToggleSwitch}"
                                          Click="TtsEnabled_Click"
                                          ToolTip="Turn voice readback of AI responses on or off."/>
                            <TextBlock Text="Read AI responses aloud"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <!-- Engine / voice / rate / volume / device — revealed only when enabled. -->
                        <StackPanel x:Name="TtsSettingsPanel"
                                    Visibility="{Binding ElementName=TtsEnabledCheck, Path=IsChecked, Converter={StaticResource BoolToVisibilityConverter}}">

                            <!-- Engine pill segmented -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Engine:"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Border CornerRadius="14"
                                        Background="{StaticResource BgSunkenBrush}"
                                        BorderBrush="{StaticResource SurfaceBorderBrush}"
                                        BorderThickness="1"
                                        Padding="3"
                                        Effect="{StaticResource SunkenDarkShadow}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="TtsEngineSystemPill"
                                                     Content="System (Windows)"
                                                     Style="{StaticResource PillRadioButton}"
                                                     GroupName="TtsEngine"
                                                     IsChecked="True"
                                                     Click="TtsEngine_Click"
                                                     ToolTip="Built-in Windows SAPI voices — always available."/>
                                        <RadioButton x:Name="TtsEnginePiperPill"
                                                     Content="Piper (neural)"
                                                     Style="{StaticResource PillRadioButton}"
                                                     GroupName="TtsEngine"
                                                     Click="TtsEngine_Click"
                                                     ToolTip="Local neural TTS — requires piper.exe plus a voice model staged on the SSD."/>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="PiperUnavailableHint"
                                           Text="Piper not staged on SSD"
                                           Foreground="{StaticResource TextDisabledBrush}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"
                                           Visibility="Collapsed"/>
                            </StackPanel>

                            <!-- Voice dropdown -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Voice:"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Width="80"/>
                                <ComboBox x:Name="TtsVoiceCombo"
                                          Style="{StaticResource GlowFocusComboBox}"
                                          Width="320"
                                          SelectionChanged="TtsVoice_SelectionChanged"
                                          ToolTip="Pick which installed voice to use."/>
                            </StackPanel>

                            <!-- Rate slider -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Rate:"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Width="80"/>
                                <Slider x:Name="TtsRateSlider"
                                        Minimum="-10" Maximum="10"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        Width="240"
                                        VerticalAlignment="Center"
                                        ValueChanged="TtsRateSlider_ValueChanged"
                                        ToolTip="Speech rate, -10 (slowest) to +10 (fastest). 0 is the default pace."/>
                                <TextBlock x:Name="TtsRateLabel" Text="0"
                                           Foreground="{StaticResource AccentCyanBrush}"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           MinWidth="30"/>
                            </StackPanel>

                            <!-- Volume slider -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Volume:"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Width="80"/>
                                <Slider x:Name="TtsVolumeSlider"
                                        Minimum="0" Maximum="100"
                                        TickFrequency="10"
                                        Width="240"
                                        VerticalAlignment="Center"
                                        ValueChanged="TtsVolumeSlider_ValueChanged"
                                        ToolTip="Output volume, 0 to 100%."/>
                                <TextBlock x:Name="TtsVolumeLabel" Text="100"
                                           Foreground="{StaticResource AccentCyanBrush}"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           MinWidth="30"/>
                            </StackPanel>

                            <!-- Output device dropdown -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Output:"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Width="80"/>
                                <ComboBox x:Name="TtsOutputDeviceCombo"
                                          Style="{StaticResource GlowFocusComboBox}"
                                          Width="320"
                                          SelectionChanged="TtsOutputDevice_SelectionChanged"
                                          ToolTip="Where to play the voice. Leave on default unless you want it on a specific output (e.g. a VR headset)."/>
                                <Button Content="Refresh"
                                        Style="{StaticResource GhostSecondaryButton}"
                                        Margin="10,0,0,0"
                                        Click="TtsOutputRefresh_Click"
                                        ToolTip="Re-scan audio output devices."/>
                            </StackPanel>

                            <!-- Test voice -->
                            <Button Content="Test voice"
                                    Style="{StaticResource GhostSecondaryButton}"
                                    HorizontalAlignment="Left"
                                    Click="TtsTest_Click"
                                    ToolTip="Speak a short sample using the current voice + rate + volume + output device."/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Voice / Card 2: Speech input (STT) -->
                <Border x:Name="VoiceInputCard" Style="{StaticResource NeumorphicCard}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Speech input"
                                   Style="{StaticResource H2Text}"/>
                        <TextBlock Text="Microphone and Whisper model used when you talk to the assistant."
                                   Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap" Margin="0,4,0,10"/>

                        <!-- Mic dropdown -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Microphone:"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Width="100"/>
                            <ComboBox x:Name="MicDeviceCombo"
                                      Style="{StaticResource GlowFocusComboBox}"
                                      Width="320"
                                      SelectionChanged="MicDevice_SelectionChanged"
                                      ToolTip="Pick which connected microphone to use for voice input."/>
                            <Button Content="Refresh"
                                    Style="{StaticResource GhostSecondaryButton}"
                                    Margin="10,0,0,0"
                                    Click="MicRefresh_Click"
                                    ToolTip="Re-scan recording devices."/>
                        </StackPanel>

                        <!-- Whisper size pill segmented -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Whisper model:"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Border CornerRadius="14"
                                    Background="{StaticResource BgSunkenBrush}"
                                    BorderBrush="{StaticResource SurfaceBorderBrush}"
                                    BorderThickness="1"
                                    Padding="3"
                                    Effect="{StaticResource SunkenDarkShadow}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="WhisperTinyPill"
                                                 Content="Tiny"
                                                 Style="{StaticResource PillRadioButton}"
                                                 GroupName="WhisperSize"
                                                 Click="WhisperSize_Click"
                                                 ToolTip="~75 MB — fastest, least accurate."/>
                                    <RadioButton x:Name="WhisperBasePill"
                                                 Content="Base"
                                                 Style="{StaticResource PillRadioButton}"
                                                 GroupName="WhisperSize"
                                                 IsChecked="True"
                                                 Click="WhisperSize_Click"
                                                 ToolTip="~142 MB — good balance (default)."/>
                                    <RadioButton x:Name="WhisperSmallPill"
                                                 Content="Small"
                                                 Style="{StaticResource PillRadioButton}"
                                                 GroupName="WhisperSize"
                                                 Click="WhisperSize_Click"
                                                 ToolTip="~466 MB — more accurate."/>
                                    <RadioButton x:Name="WhisperMediumPill"
                                                 Content="Medium"
                                                 Style="{StaticResource PillRadioButton}"
                                                 GroupName="WhisperSize"
                                                 Click="WhisperSize_Click"
                                                 ToolTip="~1.5 GB — best accuracy, slowest."/>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="WhisperReloadHint"
                                       Foreground="{StaticResource TextDisabledBrush}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       Visibility="Collapsed"/>
                        </StackPanel>

                        <!-- Auto-send toggle -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ToggleButton x:Name="AutoSendVoiceCheck"
                                          Style="{StaticResource NeonToggleSwitch}"
                                          Click="AutoSendVoice_Click"
                                          ToolTip="When on, your spoken prompt is sent immediately. When off, the transcription drops into the prompt box for review first."/>
                            <TextBlock Text="Auto-send transcribed voice"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Voice / Card 3: Push-to-Talk (HOTAS) — Sim-only -->
                <Border x:Name="PttCard" Style="{StaticResource NeumorphicCard}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Push-to-Talk (HOTAS Voice Input)"
                                   Style="{StaticResource H2Text}"/>
                        <TextBlock Text="Assign a joystick button to trigger voice queries while flying."
                                   Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap" Margin="0,4,0,10"/>

                        <!-- Three NeonToggleSwitches in a row -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ToggleButton x:Name="PttEnabledCheck"
                                              Style="{StaticResource NeonToggleSwitch}"
                                              Click="PttEnabled_Click"
                                              ToolTip="Turn HOTAS-button voice input on or off."/>
                                <TextBlock Text="Enable Push-to-Talk"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                                <ToggleButton x:Name="PttSoundCheck"
                                              Style="{StaticResource NeonToggleSwitch}"
                                              IsChecked="True"
                                              Click="PttSound_Click"
                                              ToolTip="Play a short beep when listening starts and stops."/>
                                <TextBlock Text="Activation sounds"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                                <ToggleButton x:Name="PttOverlayCheck"
                                              Style="{StaticResource NeonToggleSwitch}"
                                              IsChecked="True"
                                              Click="PttOverlay_Click"
                                              ToolTip="Show the always-on-top status overlay while flying."/>
                                <TextBlock Text="Show overlay"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Configure input: revealed only when PTT is enabled. -->
                        <Expander x:Name="PttConfigureInputExpander"
                                  Header="Configure input"
                                  Style="{StaticResource NeumorphicExpander}"
                                  IsExpanded="False"
                                  Margin="0,0,0,4"
                                  Visibility="{Binding ElementName=PttEnabledCheck, Path=IsChecked, Converter={StaticResource BoolToVisibilityConverter}}"
                                  ToolTip="Pick the joystick, the trigger button, and how the button latches.">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Device:"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <ComboBox x:Name="PttDeviceCombo"
                                              Style="{StaticResource GlowFocusComboBox}"
                                              Width="250" Margin="8,0,0,0"
                                              SelectionChanged="PttDeviceCombo_SelectionChanged"
                                              ToolTip="Pick which connected HOTAS / joystick owns the PTT button."/>
                                    <Button Content="Refresh"
                                            Style="{StaticResource GhostSecondaryButton}"
                                            Margin="10,0,0,0" Click="PttRefreshDevices_Click"
                                            ToolTip="Re-scan for connected DirectInput devices."/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Button:"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="PttButtonLabel" Text="(none)"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource AccentCyanBrush}"
                                               MinWidth="60"/>
                                    <Button x:Name="PttDetectButton" Content="Detect button"
                                            Style="{StaticResource GhostSecondaryButton}"
                                            Margin="10,0,0,0" Click="PttDetectButton_Click"
                                            ToolTip="Press a HOTAS button next to assign it as the PTT trigger."/>
                                    <Button Content="Test beep"
                                            Style="{StaticResource GhostSecondaryButton}"
                                            Margin="8,0,0,0" Click="PttTestBeep_Click"
                                            ToolTip="Play the activation beep so you can verify the output device."/>
                                </StackPanel>

                                <!-- Mode pill segmented control -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="Mode:"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Border CornerRadius="14"
                                            Background="{StaticResource BgSunkenBrush}"
                                            BorderBrush="{StaticResource SurfaceBorderBrush}"
                                            BorderThickness="1"
                                            Padding="3"
                                            Effect="{StaticResource SunkenDarkShadow}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="PttModeHold" Content="Hold to talk"
                                                         Style="{StaticResource PillRadioButton}"
                                                         IsChecked="True" Click="PttMode_Click"
                                                         ToolTip="Hold the button while you speak; release to send."/>
                                            <RadioButton x:Name="PttModeToggle" Content="Toggle (press to start/stop)"
                                                         Style="{StaticResource PillRadioButton}"
                                                         Click="PttMode_Click"
                                                         ToolTip="Tap once to start listening, tap again to send."/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Expander>

                        <TextBlock x:Name="PttStatusText"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                </StackPanel>
            </Grid>

            <!-- ─────────────────────── Sim tab ──────────────────────── -->
            <!-- DCS controller bindings import wizard. Gated by the
                 Flight Sim profile (same rule as the Voice tab). -->
            <Grid x:Name="SimTab" Visibility="Collapsed">
                <Border x:Name="BindingsImportCard" Style="{StaticResource NeumorphicCard}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Import Controller Bindings"
                                   Style="{StaticResource H2Text}"
                                   ToolTip="Import flight-sim controller bindings into a document library so the AI can reference them."/>

                        <!-- Step 0: Game selection ─────────────────────────── -->
                        <StackPanel x:Name="BindingsStep0" Margin="0,8,0,0">
                            <TextBlock Text="Select your game:"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,8"/>

                            <!-- Segmented control: one raised card with three inner buttons -->
                            <Border HorizontalAlignment="Left"
                                    CornerRadius="10"
                                    Background="{StaticResource RaisedSurfaceGradientBrush}"
                                    BorderBrush="{StaticResource SurfaceBorderBrush}"
                                    BorderThickness="1"
                                    Padding="4"
                                    Effect="{StaticResource RaisedDarkShadowSmall}">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="DCS World"
                                            Style="{StaticResource SegmentedGameButton}"
                                            Tag="Selected"
                                            Click="BindingsDcsGame_Click"/>
                                    <Button Content="IL-2 — Coming Soon"
                                            Style="{StaticResource SegmentedGameButton}"
                                            IsEnabled="False"/>
                                    <Button Content="War Thunder — Coming Soon"
                                            Style="{StaticResource SegmentedGameButton}"
                                            IsEnabled="False"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Step 1: Folder detection ───────────────────────── -->
                        <StackPanel x:Name="BindingsStep1" Visibility="Collapsed" Margin="0,10,0,0">
                            <TextBlock x:Name="DcsFolderStatusText"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Browse manually"
                                        Style="{StaticResource GhostSecondaryButton}"
                                        Margin="0,0,8,0"
                                        Click="BindingsBrowseFolder_Click"/>
                                <Button x:Name="BindingsStep1NextButton"
                                        Content="Scan for aircraft"
                                        Style="{StaticResource TactilePrimaryButton}"
                                        Margin="0,0,8,0"
                                        Click="BindingsStep1Next_Click"/>
                                <Button Content="← Back"
                                        Style="{StaticResource GhostSecondaryButton}"
                                        Click="BindingsStep1Back_Click"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Step 2: Aircraft selection ─────────────────────── -->
                        <StackPanel x:Name="BindingsStep2" Visibility="Collapsed" Margin="0,10,0,0">
                            <TextBlock x:Name="AircraftScanSummaryText"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Select All"
                                        Style="{StaticResource GhostSecondaryButton}"
                                        Margin="0,0,8,0"
                                        Click="BindingsSelectAll_Click"/>
                                <Button Content="Deselect All"
                                        Style="{StaticResource GhostSecondaryButton}"
                                        Click="BindingsDeselectAll_Click"/>
                            </StackPanel>
                            <ListView x:Name="AircraftList" Height="130" SelectionMode="Single"
                                      Background="{StaticResource BgSunkenBrush}"
                                      BorderBrush="{StaticResource SurfaceBorderBrush}"
                                      BorderThickness="1"
                                      Foreground="{StaticResource TextPrimaryBrush}">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="4,2"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <!-- The whole row is the click target so users don't have
                                             to land on the 14×14 CheckBox (task #56). CheckBox is
                                             hit-test-invisible — AircraftRow_Click toggles IsSelected
                                             and refreshes the list to reflect the change visually. -->
                                        <Border Background="Transparent"
                                                Cursor="Hand"
                                                MouseLeftButtonUp="AircraftRow_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          IsEnabled="{Binding CanImport}"
                                                          IsHitTestVisible="False"
                                                          Focusable="False"
                                                          VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding DisplayLabel}"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                <TextBlock Text=" (already imported)" VerticalAlignment="Center"
                                                           Foreground="{StaticResource StatusWarningBrush}"
                                                           FontStyle="Italic"
                                                           Visibility="{Binding AlreadyImportedVisibility}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="BindingsImportButton" Content="Import selected"
                                        Style="{StaticResource TactilePrimaryButton}"
                                        Margin="0,0,8,0"
                                        Click="BindingsImport_Click"/>
                                <Button Content="← Back"
                                        Style="{StaticResource GhostSecondaryButton}"
                                        Click="BindingsStep2Back_Click"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Step 3: Progress / results ─────────────────────── -->
                        <StackPanel x:Name="BindingsStep3" Visibility="Collapsed" Margin="0,10,0,0">
                            <TextBlock x:Name="BindingsProgressText"
                                       Foreground="{StaticResource AccentCyanBrush}"
                                       Margin="0,0,0,6" TextWrapping="Wrap"/>
                            <TextBlock x:Name="BindingsResultText" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock x:Name="BindingsErrorText"
                                       Foreground="{StaticResource StatusDangerBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,6"
                                       Visibility="Collapsed"/>
                            <TextBlock Text="These files are now in your document library. Rebuild the index to make them searchable."
                                       Style="{StaticResource CaptionText}"
                                       TextWrapping="Wrap" Margin="0,4,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Import again (overwrite)"
                                        Style="{StaticResource GhostSecondaryButton}"
                                        Margin="0,0,8,0"
                                        Click="BindingsImportAgain_Click"/>
                                <Button Content="Start over"
                                        Style="{StaticResource GhostSecondaryButton}"
                                        Click="BindingsStartOver_Click"/>
                            </StackPanel>
                        </StackPanel>

                    </StackPanel>
                </Border>
            </Grid>

            <!-- ────────────────────── System tab ────────────────────── -->
            <!-- System Compatibility probe + (stage 2) Dependencies. -->
            <Grid x:Name="SystemTab" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 0: compatibility info  -->
                    <RowDefinition Height="Auto"/> <!-- 1: dependencies card   -->
                    <RowDefinition Height="Auto"/> <!-- 2: model parameters    -->
                </Grid.RowDefinitions>
                <Border Grid.Row="0" x:Name="SystemCompatibilityCard" Style="{StaticResource NeumorphicCard}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="System info"
                                   Style="{StaticResource H2Text}"
                                   Margin="0,0,0,8"/>

                        <TextBlock x:Name="CompatibilityGpuText"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   ToolTip="Best GPU detected on this machine."/>
                        <TextBlock x:Name="CompatibilityCpuText"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,2,0,0"
                                   ToolTip="CPU instruction set / architecture."/>
                        <TextBlock x:Name="CompatibilityOsText"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,2,0,0"
                                   ToolTip="Detected operating system version."/>
                        <TextBlock Text="Ollama typically auto-selects best available backend. This app detects hardware for visibility."
                                   Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Stage 3 (Mac-parity §B2): Dependencies surface. Banner
                     outcome (Success → green, Error → red, Collapsed when
                     neither resolved yet) is driven by SetDependenciesOutcome
                     so mutual exclusion is structural. Missing items render
                     as a per-item list; the primary "Install" button reuses
                     the existing modal DependencyInstallDialog via
                     EnsureDependenciesReadyAsync(forcePrompt:true). -->
                <Border Grid.Row="1" x:Name="DependenciesCard" Style="{StaticResource NeumorphicCard}">
                    <StackPanel>
                        <TextBlock Text="Dependencies"
                                   Style="{StaticResource H2Text}"
                                   Margin="0,0,0,10"/>

                        <Border x:Name="DependenciesSuccessBanner"
                                Style="{StaticResource SuccessBanner}"
                                Visibility="Collapsed"
                                Margin="0,0,0,10">
                            <TextBlock x:Name="DependenciesSuccessBannerText"
                                       Text="All required components installed."
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextWrapping="Wrap"/>
                        </Border>
                        <Border x:Name="DependenciesDangerBanner"
                                Style="{StaticResource DangerBanner}"
                                Visibility="Collapsed"
                                Margin="0,0,0,10">
                            <TextBlock x:Name="DependenciesDangerBannerText"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <ItemsControl x:Name="DependenciesMissingList"
                                      Visibility="Collapsed"
                                      Margin="0,0,0,10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                        <theme:LedStatusIndicator State="Error"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="InstallMissingButton"
                                    Content="Install missing components"
                                    Style="{StaticResource TactilePrimaryButton}"
                                    Visibility="Collapsed"
                                    Click="InstallMissing_Click"
                                    ToolTip="Open the offline install picker for the missing prerequisites."/>
                            <Button Content="Re-check"
                                    Style="{StaticResource GhostSecondaryButton}"
                                    Margin="8,0,0,0"
                                    Click="RerunDependencyCheck_Click"
                                    ToolTip="Re-scan the machine for required components."/>
                            <Button Content="Open prerequisites folder"
                                    Style="{StaticResource GhostSecondaryButton}"
                                    Margin="8,0,0,0"
                                    Click="OpenPrereqsFolder_Click"
                                    ToolTip="Open the offline installer bundle on the SSD."/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- #58 Model parameters: per-request overrides for Ollama's
                     core sampling knobs. Each slider has a "use model default"
                     sentinel at its low end; when at that position the option
                     is omitted from the request so the model's compiled-in
                     default is preserved. Reset returns every slider to that
                     sentinel. Defaults shown in the value label as "default". -->
                <Border Grid.Row="2" x:Name="ModelParametersCard" Style="{StaticResource NeumorphicCard}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Model parameters"
                                   Style="{StaticResource H2Text}"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="Tune how the model responds. Sliders at the leftmost position use the model's built-in default."
                                   Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <!-- Context window (num_ctx) -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Context:"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Width="110"/>
                            <Slider x:Name="ModelContextSlider"
                                    Minimum="0" Maximum="32768"
                                    SmallChange="512" LargeChange="2048"
                                    TickFrequency="2048"
                                    Width="320"
                                    VerticalAlignment="Center"
                                    ValueChanged="ModelContextSlider_ValueChanged"
                                    ToolTip="num_ctx: how many tokens of conversation + RAG context the model sees. Larger = more memory and slower. 0 uses the model default."/>
                            <TextBlock x:Name="ModelContextLabel" Text="default"
                                       Foreground="{StaticResource AccentCyanBrush}"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       MinWidth="60"/>
                        </StackPanel>

                        <!-- Temperature -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Temperature:"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Width="110"/>
                            <Slider x:Name="ModelTemperatureSlider"
                                    Minimum="-0.05" Maximum="2.0"
                                    SmallChange="0.05" LargeChange="0.1"
                                    TickFrequency="0.1"
                                    Width="320"
                                    VerticalAlignment="Center"
                                    ValueChanged="ModelTemperatureSlider_ValueChanged"
                                    ToolTip="temperature: randomness of token sampling. 0 = deterministic, 2 = very creative. Far-left uses the model default."/>
                            <TextBlock x:Name="ModelTemperatureLabel" Text="default"
                                       Foreground="{StaticResource AccentCyanBrush}"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       MinWidth="60"/>
                        </StackPanel>

                        <!-- Top P -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Top P:"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Width="110"/>
                            <Slider x:Name="ModelTopPSlider"
                                    Minimum="-0.05" Maximum="1.0"
                                    SmallChange="0.05" LargeChange="0.1"
                                    TickFrequency="0.05"
                                    Width="320"
                                    VerticalAlignment="Center"
                                    ValueChanged="ModelTopPSlider_ValueChanged"
                                    ToolTip="top_p: nucleus sampling cutoff. Lower = more focused, higher = broader vocabulary. Far-left uses the model default."/>
                            <TextBlock x:Name="ModelTopPLabel" Text="default"
                                       Foreground="{StaticResource AccentCyanBrush}"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       MinWidth="60"/>
                        </StackPanel>

                        <!-- Max output (num_predict) -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Max output:"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Width="110"/>
                            <Slider x:Name="ModelMaxOutputSlider"
                                    Minimum="-128" Maximum="8192"
                                    SmallChange="128" LargeChange="512"
                                    TickFrequency="512"
                                    Width="320"
                                    VerticalAlignment="Center"
                                    ValueChanged="ModelMaxOutputSlider_ValueChanged"
                                    ToolTip="num_predict: hard cap on tokens generated per response. Useful for reasoning models that can loop. Far-left = unlimited (model default)."/>
                            <TextBlock x:Name="ModelMaxOutputLabel" Text="unlimited"
                                       Foreground="{StaticResource AccentCyanBrush}"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       MinWidth="60"/>
                        </StackPanel>

                        <!-- Thinking (top-level `think`) -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Thinking:"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Width="110"/>
                            <ComboBox x:Name="ModelThinkModeCombo"
                                      Style="{StaticResource GlowFocusComboBox}"
                                      Width="320"
                                      VerticalAlignment="Center"
                                      SelectionChanged="ModelThinkModeCombo_SelectionChanged"
                                      ToolTip="think: control reasoning for thinking models. Default = the model's built-in behavior. Off disables reasoning (fixes runaway/looping reasoners). Low/Medium/High set reasoning effort on models that support it. Only works on models that declare thinking support — others use Max output instead.">
                                <ComboBoxItem Content="Default" Tag=""/>
                                <ComboBoxItem Content="Off (no reasoning)" Tag="off"/>
                                <ComboBoxItem Content="Low" Tag="low"/>
                                <ComboBoxItem Content="Medium" Tag="medium"/>
                                <ComboBoxItem Content="High" Tag="high"/>
                            </ComboBox>
                        </StackPanel>

                        <Button Content="Reset to model defaults"
                                Style="{StaticResource GhostSecondaryButton}"
                                HorizontalAlignment="Left"
                                Click="ResetModelParameters_Click"
                                ToolTip="Clear every override; all five values (including Thinking) fall back to whatever the active model ships with."/>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>
    </Grid>
    </ScrollViewer>

    <!-- ═════════════════════════════════════════════════════════════
         FTUE Overlay: shown on first launch. Semi-transparent scrim
         plus a neon "spotlight" ring positioned over the step's
         target element (set in code-behind). The instruction card
         floats in the lower-right corner.
         ═════════════════════════════════════════════════════════════ -->
    <Grid x:Name="FtueOverlay" Visibility="Collapsed">
        <!-- Scrim: catches clicks so the user can't interact with
             the underlying UI until they finish or skip FTUE. -->
        <Rectangle Fill="#B3000000"/>

        <!-- Spotlight canvas: code-behind positions FtueSpotlight
             over the target element using TransformToVisual. -->
        <Canvas x:Name="FtueSpotlightCanvas">
            <Border x:Name="FtueSpotlight"
                    Style="{StaticResource SpotlightRing}"
                    Visibility="Collapsed"/>
        </Canvas>

        <!-- Instruction card: pinned to the bottom-right. -->
        <Border HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,32,40"
                MaxWidth="380"
                Style="{StaticResource NeumorphicCard}">
            <StackPanel>
                <TextBlock x:Name="FtueStepLabel"
                           Text="Step 1 of 4"
                           Style="{StaticResource CaptionText}"
                           Foreground="{StaticResource AccentCyanBrush}"
                           Margin="0,0,0,6"/>
                <TextBlock x:Name="FtueTitleText"
                           Text="Check compatibility"
                           Style="{StaticResource H2Text}"/>
                <TextBlock x:Name="FtueBodyText"
                           Text="Confirm your system can run the local AI stack."
                           Style="{StaticResource BodyText}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Skip"
                            Style="{StaticResource GhostSecondaryButton}"
                            Click="OnFtueSkipClick"/>
                    <Button x:Name="FtueNextButton"
                            Content="Next"
                            Margin="8,0,0,0"
                            Style="{StaticResource TactilePrimaryButton}"
                            Click="OnFtueNextClick"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
    </Grid>
</Window>
