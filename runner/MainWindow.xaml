<Window x:Class="FreeAiSsd.Runner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Free AI SSD Runner" Height="1020" Width="1100">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Start Ollama" Padding="12,6" Click="Start_Click"/>
            <Button x:Name="UnlockDriveButton" Content="Unlock Drive" Padding="12,6" Margin="8,0,0,0" Click="UnlockDrive_Click" Visibility="Collapsed"/>
            <Button Content="Stop Ollama" Padding="12,6" Margin="8,0,0,0" Click="Stop_Click"/>
            <Button Content="Open Chat UI (browser)" Padding="12,6" Margin="8,0,0,0" Click="OpenBrowser_Click"/>
            <TextBlock x:Name="StatusText" Margin="12,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="System Compatibility" FontWeight="Bold"/>
                <TextBlock x:Name="CompatibilityGpuText" Margin="0,4,0,0"/>
                <TextBlock x:Name="CompatibilityCpuText" Margin="0,2,0,0"/>
                <TextBlock x:Name="CompatibilityOsText" Margin="0,2,0,0"/>
                <TextBlock x:Name="CompatibilityDepsText" Margin="0,2,0,0"/>
                <TextBlock Text="Ollama typically auto-selects best available backend. This app detects hardware for visibility."
                           TextWrapping="Wrap" Foreground="#555" Margin="0,6,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Re-run dependency check" Click="RerunDependencyCheck_Click"/>
                    <Button Content="Open prerequisites folder" Margin="8,0,0,0" Click="OpenPrereqsFolder_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Model:" VerticalAlignment="Center"/>
            <ComboBox x:Name="ModelCombo" Width="220" Margin="8,0,0,0"/>
            <TextBox x:Name="PromptText" Width="480" Margin="8,0,0,0" Text="Say hello from portable SSD."/>
            <Button x:Name="SendButton" Content="Send" Margin="8,0,0,0" Click="Send_Click"/>
            <Button x:Name="StopButton" Content="Stop" Margin="4,0,0,0" Click="Stop_Generation_Click" Visibility="Collapsed" Foreground="#C00"/>
            <TextBlock x:Name="StreamingIndicator" Text="● Generating..." Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#0078D4" Visibility="Collapsed"/>
        </StackPanel>

        <Border Grid.Row="3" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Reference Documents" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Library:" VerticalAlignment="Center"/>
                    <ComboBox x:Name="LibraryCombo" Width="250" Margin="8,0,0,0" SelectionChanged="LibraryCombo_SelectionChanged"/>
                    <TextBox x:Name="NewLibraryNameText" Width="220" Margin="8,0,0,0" Text="My library"/>
                    <Button Content="Create library" Margin="8,0,0,0" Click="CreateLibrary_Click"/>
                </StackPanel>
                <WrapPanel Margin="0,8,0,0">
                    <Button Content="Add files" Click="AddFiles_Click" Margin="0,0,8,0"/>
                    <Button Content="Add folder" Click="AddFolder_Click" Margin="0,0,8,0"/>
                    <Button Content="Sweep folders now" Click="SweepFolders_Click" Margin="0,0,8,0"/>
                    <Button Content="Rebuild index" Click="RebuildIndex_Click" Margin="0,0,8,0"/>
                    <Button Content="Pull embedding model" Click="PullEmbeddingModel_Click" Margin="0,0,8,0"/>
                    <Button Content="Remove selected file" Click="RemoveFile_Click"/>
                </WrapPanel>
                <TextBlock x:Name="IndexingStatusText" Margin="0,6,0,0" Foreground="#444"/>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ListBox x:Name="LibraryFilesList" Height="90" DisplayMemberPath="FileName"/>
                    <ListBox Grid.Column="1" x:Name="SourcesList" Height="90"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- Import Controller Bindings (multi-step wizard)             -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="4" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Import Controller Bindings" FontWeight="Bold"/>

                <!-- Step 0: Game selection ─────────────────────────── -->
                <StackPanel x:Name="BindingsStep0" Margin="0,8,0,0">
                    <TextBlock Text="Select your game:" Foreground="#555" Margin="0,0,0,6"/>
                    <WrapPanel>
                        <Button Content="DCS World" Padding="12,6" Margin="0,0,8,0" Click="BindingsDcsGame_Click"/>
                        <Button Content="IL-2 — Coming Soon" Padding="12,6" Margin="0,0,8,0" IsEnabled="False" Foreground="#999"/>
                        <Button Content="War Thunder — Coming Soon" Padding="12,6" IsEnabled="False" Foreground="#999"/>
                    </WrapPanel>
                </StackPanel>

                <!-- Step 1: Folder detection ───────────────────────── -->
                <StackPanel x:Name="BindingsStep1" Visibility="Collapsed" Margin="0,8,0,0">
                    <TextBlock x:Name="DcsFolderStatusText" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Browse manually" Padding="10,5" Margin="0,0,8,0" Click="BindingsBrowseFolder_Click"/>
                        <Button x:Name="BindingsStep1NextButton" Content="Scan for aircraft" Padding="10,5" Margin="0,0,8,0" Click="BindingsStep1Next_Click"/>
                        <Button Content="← Back" Padding="10,5" Foreground="#555" Click="BindingsStep1Back_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- Step 2: Aircraft selection ─────────────────────── -->
                <StackPanel x:Name="BindingsStep2" Visibility="Collapsed" Margin="0,8,0,0">
                    <TextBlock x:Name="AircraftScanSummaryText" Foreground="#555" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="Select All" Padding="8,4" Margin="0,0,8,0" Click="BindingsSelectAll_Click"/>
                        <Button Content="Deselect All" Padding="8,4" Click="BindingsDeselectAll_Click"/>
                    </StackPanel>
                    <ListView x:Name="AircraftList" Height="130" SelectionMode="Single" BorderThickness="1" BorderBrush="#DDD">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="4,2"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              IsEnabled="{Binding CanImport}"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DisplayLabel}"
                                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    <TextBlock Text=" (already imported)" VerticalAlignment="Center"
                                               Foreground="#E07000" FontStyle="Italic"
                                               Visibility="{Binding AlreadyImportedVisibility}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="BindingsImportButton" Content="Import selected" Padding="10,5" Margin="0,0,8,0" Click="BindingsImport_Click"/>
                        <Button Content="← Back" Padding="10,5" Foreground="#555" Click="BindingsStep2Back_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- Step 3: Progress / results ─────────────────────── -->
                <StackPanel x:Name="BindingsStep3" Visibility="Collapsed" Margin="0,8,0,0">
                    <TextBlock x:Name="BindingsProgressText" Foreground="#0078D4" Margin="0,0,0,6" TextWrapping="Wrap"/>
                    <TextBlock x:Name="BindingsResultText" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock x:Name="BindingsErrorText" Foreground="#C00" TextWrapping="Wrap" Margin="0,0,0,6"
                               Visibility="Collapsed"/>
                    <TextBlock Text="These files are now in your document library. Rebuild the index to make them searchable."
                               TextWrapping="Wrap" Foreground="#555" Margin="0,4,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Import again (overwrite)" Padding="10,5" Margin="0,0,8,0" Click="BindingsImportAgain_Click"/>
                        <Button Content="Start over" Padding="10,5" Foreground="#555" Click="BindingsStartOver_Click"/>
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </Border>

        <TextBox Grid.Row="5" x:Name="ResponseText" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
        <TextBox Grid.Row="6" x:Name="LogText" Height="140" Margin="0,8,0,0" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
    </Grid>
</Window>
