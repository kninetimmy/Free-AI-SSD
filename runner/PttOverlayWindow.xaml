<Window x:Class="FreeAiSsd.Runner.PttOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:runner="clr-namespace:FreeAiSsd.Runner"
        x:Name="OverlayRoot"
        Title="PTT Status"
        Width="120" Height="40"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <!--  Translucent neumorphic pill. The RootBorder keeps its x:Name so
          the drag handlers in code-behind continue to capture mouse
          events against it. The StatusDot ellipse also keeps its name so
          UpdateState(...) can still swap Fill for each pipeline state.
          The DataTrigger below binds to the window's PipelineState DP
          (an enum), not to UI text, so the pulse animation survives
          localization or label-string changes.  -->
    <Border x:Name="RootBorder"
            CornerRadius="18"
            Background="#CC1A1D24"
            BorderBrush="{StaticResource FocusBorderGradientBrush}"
            BorderThickness="1"
            Padding="12,6"
            SnapsToDevicePixels="True"
            MouseLeftButtonDown="Border_MouseLeftButtonDown"
            MouseLeftButtonUp="Border_MouseLeftButtonUp"
            MouseMove="Border_MouseMove"
            Cursor="Hand">
        <Border.Effect>
            <DropShadowEffect Color="{StaticResource SurfaceShadowColor}"
                              Direction="315"
                              ShadowDepth="3"
                              BlurRadius="10"
                              Opacity="0.85"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <!--  Pulsing cyan LED while recording. The storyboard fires
                  whenever the window's PipelineState DP equals Listening;
                  it animates opacity on a forever-looping, auto-reversing
                  timeline.  -->
            <Ellipse x:Name="StatusDot" Width="10" Height="10"
                     Margin="0,0,8,0"
                     Fill="{StaticResource TextMutedBrush}">
                <Ellipse.Effect>
                    <DropShadowEffect Color="{StaticResource AccentCyanColor}"
                                      ShadowDepth="0"
                                      BlurRadius="12"
                                      Opacity="0.85"/>
                </Ellipse.Effect>
                <Ellipse.Style>
                    <Style TargetType="{x:Type Ellipse}">
                        <Setter Property="Opacity" Value="1.0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PipelineState, ElementName=OverlayRoot}"
                                         Value="{x:Static runner:PttState.Listening}">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="PulseStoryboard">
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="1.0" To="0.25"
                                                             Duration="0:0:0.7"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="PulseStoryboard"/>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>
            <TextBlock x:Name="StatusLabel" Text="Ready"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontFamily="{StaticResource PrimaryFontFamily}"
                       FontSize="11"
                       VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
