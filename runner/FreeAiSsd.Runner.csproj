<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="SharpDX.DirectInput" Version="4.2.0" />
    <PackageReference Include="System.Speech" Version="8.0.0" />
    <PackageReference Include="Whisper.net" Version="1.7.4" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.7.4" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\shared\FreeAiSsd.Shared.csproj" />
  </ItemGroup>
  <!--
    Shared neumorphic theme. The XAML resource dictionaries live in
    ..\shared\UI\Theme but are embedded into THIS assembly as pack
    resources so App.xaml can MergedDictionary them via
    pack://application:,,,/UI/Theme/Theme.xaml.
  -->
  <ItemGroup>
    <Page Include="..\shared\UI\Theme\Colors.xaml">
      <Link>UI\Theme\Colors.xaml</Link>
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Page Include="..\shared\UI\Theme\Shadows.xaml">
      <Link>UI\Theme\Shadows.xaml</Link>
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Page Include="..\shared\UI\Theme\Typography.xaml">
      <Link>UI\Theme\Typography.xaml</Link>
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Page Include="..\shared\UI\Theme\Controls.xaml">
      <Link>UI\Theme\Controls.xaml</Link>
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Page Include="..\shared\UI\Theme\Theme.xaml">
      <Link>UI\Theme\Theme.xaml</Link>
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>
  <!--
    LedStatusIndicator is a reusable UserControl. Linked in so the
    runner can drop an LED anywhere in its visual tree without taking
    a dependency on prep-app.
  -->
  <ItemGroup>
    <Page Include="..\shared\UI\Theme\LedStatusIndicator.xaml">
      <Link>UI\Theme\LedStatusIndicator.xaml</Link>
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Compile Include="..\shared\UI\Theme\LedStatusIndicator.xaml.cs">
      <Link>UI\Theme\LedStatusIndicator.xaml.cs</Link>
      <DependentUpon>LedStatusIndicator.xaml</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
