<Window x:Class="FreeAiSsd.Runner.UnlockDriveDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unlock Encrypted SSD"
        Height="190"
        Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgBaseBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource PrimaryFontFamily}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Enter the SSD passphrase to unlock access."
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Passphrase:" Width="95" VerticalAlignment="Center"/>
            <PasswordBox x:Name="PasswordBox" Width="270"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel"
                    MinWidth="90"
                    Margin="0,0,8,0"
                    Style="{StaticResource GhostSecondaryButton}"
                    Click="Cancel_Click"/>
            <Button Content="Unlock"
                    MinWidth="90"
                    IsDefault="True"
                    Style="{StaticResource TactilePrimaryButton}"
                    Click="Unlock_Click"/>
        </StackPanel>
    </Grid>
</Window>
