<Window x:Class="FreeAiSsd.Runner.RenameLibraryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename Library"
        Height="170"
        Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Loaded="Window_Loaded"
        Background="{StaticResource BgBaseBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource PrimaryFontFamily}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Enter a new name for this library."
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Name:" Width="60" VerticalAlignment="Center"/>
            <TextBox x:Name="NameBox"
                     Width="300"
                     Style="{StaticResource GlowFocusTextBox}"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel"
                    MinWidth="90"
                    Margin="0,0,8,0"
                    Style="{StaticResource GhostSecondaryButton}"
                    Click="Cancel_Click"/>
            <Button Content="Rename"
                    MinWidth="90"
                    IsDefault="True"
                    Style="{StaticResource TactilePrimaryButton}"
                    Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
