<Window x:Class="FreeAiSsd.Companion.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Companion Settings" Height="340" Width="460" WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Host Address"/><TextBox x:Name="HostAddressText"/>
            <TextBlock Text="Host Port" Margin="0,8,0,0"/><TextBox x:Name="HostPortText"/>
            <TextBlock Text="API Key" Margin="0,8,0,0"/><TextBox x:Name="ApiKeyText"/>
            <TextBlock Text="PTT Binding (device|button or key:F8)" Margin="0,8,0,0"/><TextBox x:Name="PttBindingText"/>
            <TextBlock Text="Input Device (blank=default)" Margin="0,8,0,0"/><ComboBox x:Name="InputDeviceCombo" IsEditable="True"/>
            <TextBlock Text="Output Device (blank=default)" Margin="0,8,0,0"/><TextBox x:Name="OutputDeviceText"/>
            <CheckBox x:Name="AutoReconnectCheck" Content="Auto reconnect" Margin="0,8,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Save" Width="90" Click="Save_Click"/>
            <Button Content="Cancel" Width="90" Margin="8,0,0,0" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
