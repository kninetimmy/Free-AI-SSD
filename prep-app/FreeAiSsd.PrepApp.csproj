<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\shared\FreeAiSsd.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Resources\starter-models.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="Resources\starter-models.json" />
  </ItemGroup>
  <!--
    Shared neumorphic theme. The XAML resource dictionaries live in
    ..\shared\UI\Theme but are embedded into THIS assembly as pack
    resources so App.xaml can MergedDictionary them via
    pack://application:,,,/UI/Theme/Theme.xaml.
  -->
  <ItemGroup>
    <Page Include="..\shared\UI\Theme\Colors.xaml">
      <Link>UI\Theme\Colors.xaml</Link>
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Page Include="..\shared\UI\Theme\Shadows.xaml">
      <Link>UI\Theme\Shadows.xaml</Link>
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Page Include="..\shared\UI\Theme\Typography.xaml">
      <Link>UI\Theme\Typography.xaml</Link>
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Page Include="..\shared\UI\Theme\Theme.xaml">
      <Link>UI\Theme\Theme.xaml</Link>
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>
  <!--
    ThemePreview is a developer-only scratch window for eyeballing
    theme tokens; not wired into any menu. Built into prep-app so the
    XAML compiler has somewhere to emit InitializeComponent.
  -->
  <ItemGroup>
    <Page Include="..\shared\UI\Theme\ThemePreview.xaml">
      <Link>UI\Theme\ThemePreview.xaml</Link>
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Compile Include="..\shared\UI\Theme\ThemePreview.xaml.cs">
      <Link>UI\Theme\ThemePreview.xaml.cs</Link>
      <DependentUpon>ThemePreview.xaml</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
