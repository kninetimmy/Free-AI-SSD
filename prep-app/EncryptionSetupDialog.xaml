<Window x:Class="FreeAiSsd.PrepApp.EncryptionSetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enable SSD Encryption"
        Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Background="{StaticResource BgBaseBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Set a passphrase required to unlock this SSD in Runner."
                   Style="{StaticResource BodyText}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16"/>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Passphrase:" Style="{StaticResource BodySecondaryText}" VerticalAlignment="Center"/>
            <PasswordBox x:Name="PasswordBox" Grid.Column="1"
                         Background="{StaticResource BgSunkenBrush}"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         CaretBrush="{StaticResource AccentCyanBrush}"
                         BorderBrush="{StaticResource SurfaceBorderBrush}"
                         BorderThickness="1"
                         Padding="8,6"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Confirm:" Style="{StaticResource BodySecondaryText}" VerticalAlignment="Center"/>
            <PasswordBox x:Name="ConfirmPasswordBox" Grid.Column="1"
                         Background="{StaticResource BgSunkenBrush}"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         CaretBrush="{StaticResource AccentCyanBrush}"
                         BorderBrush="{StaticResource SurfaceBorderBrush}"
                         BorderThickness="1"
                         Padding="8,6"/>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Style="{StaticResource GhostSecondaryButton}" MinWidth="100" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button Content="Enable" Style="{StaticResource TactilePrimaryButton}" MinWidth="100" IsDefault="True" Click="Enable_Click"/>
        </StackPanel>
    </Grid>
</Window>
