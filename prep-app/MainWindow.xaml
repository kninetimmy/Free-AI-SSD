<Window x:Class="FreeAiSsd.PrepApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Free AI SSD - Host Setup" Height="900" Width="1020">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Target Drive:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="DriveCombo" Width="500" DisplayMemberPath="Name" SelectionChanged="DriveCombo_SelectionChanged"/>
            <Button Content="Refresh" Margin="8,0,0,0" Click="RefreshDrives_Click"/>
            <CheckBox x:Name="ShowFixedDrivesCheckBox"
                      Margin="12,0,0,0"
                      VerticalAlignment="Center"
                      Content="Show fixed drives (advanced)"
                      Checked="ShowFixedDrivesChanged"
                      Unchecked="ShowFixedDrivesChanged"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Ollama Package URL:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="OllamaUrlText" Width="620" Text="https://github.com/ollama/ollama/releases/download/v0.5.7/ollama-windows-amd64.zip"/>
        </StackPanel>

        <GroupBox Header="Model Manager" Grid.Row="2" Margin="0,0,0,10">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Model tag" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="ModelTagText" Width="300" ToolTip="Examples: llama3.2:3b, qwen2.5:3b, mistral:7b"/>
                    <Button x:Name="AddModelButton" Content="Add" Margin="8,0,0,0" Click="AddModel_Click"/>
                </StackPanel>

                <GroupBox Grid.Row="1" Header="Starter models (recommended)" Margin="0,0,0,8">
                    <DockPanel Margin="8">
                        <TextBlock x:Name="StarterCatalogWarningText"
                                   DockPanel.Dock="Top"
                                   Foreground="DarkOrange"
                                   Margin="0,0,0,6"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"/>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="AddStarterModelsButton" Content="Add selected to configuration" Click="AddSelectedStarterModels_Click"/>
                            <Button x:Name="ClearStarterModelsSelectionButton" Content="Clear selection" Margin="8,0,0,0" Click="ClearStarterModelSelection_Click"/>
                        </StackPanel>
                        <DataGrid x:Name="StarterModelGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="False"
                                  HeadersVisibility="Column"
                                  Height="230">
                            <DataGrid.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="4,8,0,4"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </DataGrid.GroupStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Select" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Checked="StarterModelSelectionChanged"
                                                      Unchecked="StarterModelSelectionChanged"
                                                      HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Tag" Binding="{Binding Tag}" Width="2*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Params" Binding="{Binding Params}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Tier" Binding="{Binding SizeTier}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Best at" Binding="{Binding Description}" Width="3*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Use cases" Binding="{Binding UseCasesDisplay}" Width="2*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Sizing info" Binding="{Binding SizingWarning}" Width="2*" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </GroupBox>

                <DataGrid x:Name="ModelStatusGrid"
                          Grid.Row="2"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          SelectionMode="Extended"
                          Height="220"
                          SelectionChanged="ModelStatusGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                        <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="*"/>
                        <DataGridTextColumn Header="Sizing" Binding="{Binding SizingWarning}" Width="2*"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="*"/>
                        <DataGridTextColumn Header="Sha256" Binding="{Binding ShaPreview}" Width="*"/>
                        <DataGridTextColumn Header="Last verified" Binding="{Binding LastVerifiedDisplay}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="PullInstallButton" Content="Pull/Install" Click="PullInstall_Click"/>
                    <Button x:Name="VerifyButton" Content="Verify" Margin="8,0,0,0" Click="Verify_Click"/>
                    <Button x:Name="RemoveButton" Content="Remove/Delete..." Margin="8,0,0,0" Click="Remove_Click"/>
                    <Button x:Name="AddOrphanButton" Content="Add to config" Margin="8,0,0,0" Click="AddOrphanToConfig_Click"/>
                    <Button x:Name="PullSelectedButton" Content="Pull Selected" Margin="20,0,0,0" Click="PullSelected_Click"/>
                    <Button x:Name="CancelOperationButton" Content="Cancel Current Operation" Margin="8,0,0,0" Click="CancelOperation_Click" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox Header="Drive Preparation" Grid.Row="3" Margin="0,0,0,10">
            <StackPanel Margin="8">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Prep targets:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <CheckBox x:Name="PrepareWindowsCheckBox" Content="Prepare for Windows" IsChecked="True" Margin="0,0,10,0" Checked="PrepTargetSelectionChanged" Unchecked="PrepTargetSelectionChanged"/>
                    <CheckBox x:Name="PrepareMacCheckBox" Content="Prepare for macOS" Checked="PrepTargetSelectionChanged" Unchecked="PrepTargetSelectionChanged"/>
                </StackPanel>
                <TextBlock x:Name="MacPrepAvailabilityText" Margin="0,0,0,8" Foreground="DarkOrange" Visibility="Collapsed" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Volume label:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="VolumeLabelText" Width="240" Text="Portable AI"/>
                    <Button x:Name="FormatPrepareButton" Content="Format &amp; Prepare Drive" Margin="12,0,0,0" Click="FormatPrepare_Click"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <Button x:Name="FinalizeButton" Content="Finalize SSD" Padding="16,8" Click="Finalize_Click"/>
                <Button Content="Check SSD Readiness" Padding="16,8" Margin="8,0,0,0" Click="CheckReadiness_Click"/>
                <Button x:Name="CheckPrereqUpdatesButton" Content="Check for prereq updates" Padding="16,8" Margin="8,0,0,0" Click="CheckPrereqUpdates_Click"/>
                <ProgressBar x:Name="Progress" Width="250" Height="22" Margin="12,0,0,0"/>
                <TextBlock x:Name="StatusText" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="PrereqStatusText" Grid.Row="1" Foreground="DarkSlateBlue" Margin="0,8,0,8" Text="Prereqs: bundled"/>
            <TextBlock x:Name="WarningText" Grid.Row="1" Foreground="DarkOrange" Margin="0,32,0,8"/>
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBox x:Name="LogText" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <DataGrid x:Name="ReadinessGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Check" Binding="{Binding Check}" Width="2*"/>
                        <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="3*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</Window>
