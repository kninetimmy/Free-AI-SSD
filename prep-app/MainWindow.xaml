<Window x:Class="FreeAiSsd.PrepApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Free AI SSD - Host Setup" Height="640" Width="900">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Target Drive:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="DriveCombo" Width="500" DisplayMemberPath="Name" SelectionChanged="DriveCombo_SelectionChanged"/>
            <Button Content="Refresh" Margin="8,0,0,0" Click="RefreshDrives_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Ollama Package URL:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="OllamaUrlText" Width="620" Text="https://github.com/ollama/ollama/releases/latest/download/ollama-windows-amd64.zip"/>
        </StackPanel>

        <GroupBox Header="Models to pre-download" Grid.Row="2" Margin="0,0,0,10">
            <StackPanel Margin="8">
                <CheckBox x:Name="ModelLlama" Content="llama3.2:3b" IsChecked="True"/>
                <CheckBox x:Name="ModelQwen" Content="qwen2.5:3b" IsChecked="True"/>
                <TextBlock Foreground="Gray" Text="Models are pulled using staged ollama.exe into SSD/models."/>
            </StackPanel>
        </GroupBox>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <Button Content="Finalize SSD" Padding="16,8" Click="Finalize_Click"/>
                <ProgressBar x:Name="Progress" Width="250" Height="22" Margin="12,0,0,0"/>
                <TextBlock x:Name="StatusText" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="WarningText" Grid.Row="1" Foreground="DarkOrange" Margin="0,8,0,8"/>
            <TextBox x:Name="LogText" Grid.Row="2" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
        </Grid>
    </Grid>
</Window>
