<Window x:Class="FreeAiSsd.PrepApp.ThemedMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Message"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MaxHeight="560"
        Background="{StaticResource BgBaseBrush}">
    <Grid Margin="24" MinWidth="420">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock x:Name="IconGlyph" FontSize="26" FontFamily="Segoe UI Variable Text"
                       VerticalAlignment="Top" Margin="0,2,12,0"/>
            <ScrollViewer MaxHeight="350" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="MessageText" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                           MaxWidth="400"/>
            </ScrollViewer>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="NoButton" Content="No" Style="{StaticResource GhostSecondaryButton}"
                    MinWidth="100" Margin="0,0,10,0" Visibility="Collapsed" Click="No_Click"/>
            <Button x:Name="OkYesButton" Content="OK" Style="{StaticResource TactilePrimaryButton}"
                    MinWidth="100" Click="OkYes_Click"/>
        </StackPanel>
    </Grid>
</Window>
