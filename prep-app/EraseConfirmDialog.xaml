<Window x:Class="FreeAiSsd.PrepApp.EraseConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm drive format"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">
    <Grid Margin="16" MinWidth="520">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="WarningText" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <TextBlock Grid.Row="1" Text="Type ERASE to continue:" Margin="0,0,0,6"/>
        <TextBox x:Name="ConfirmText" Grid.Row="2" Width="180"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Proceed" Width="90" Click="Proceed_Click"/>
        </StackPanel>
    </Grid>
</Window>
