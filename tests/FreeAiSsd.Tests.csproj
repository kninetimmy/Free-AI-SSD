<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Whisper.net" Version="1.7.4" />
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\mac-runner-host\FreeAiSsd.MacRunnerHost.csproj" />
    <ProjectReference Include="..\mac-prep-host\FreeAiSsd.MacPrepHost.csproj" />
    <ProjectReference Include="..\runner-core\FreeAiSsd.RunnerCore.csproj" />
    <!--
      MAC16: prep-core/ is plain net8.0 so the test project can reference it
      directly instead of using the prior &lt;Compile Include&gt; link-source
      hack for individual prep-app files. ModelOperations + StarterModelCatalog
      + the moved services come through this reference.
    -->
    <ProjectReference Include="..\prep-core\FreeAiSsd.PrepCore.csproj" />
    <ProjectReference Include="..\shared\FreeAiSsd.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\prep-app\PrepStartupArgs.cs" Link="PrepApp\PrepStartupArgs.cs" />
    <Compile Include="..\prep-app\Services\DriveService.cs" Link="PrepApp\DriveService.cs" />
    <Compile Include="..\runner\Services\IPttVoicePipelineService.cs" Link="Runner\IPttVoicePipelineService.cs" />
    <Compile Include="..\runner\Services\PttVoicePipelineService.cs" Link="Runner\PttVoicePipelineService.cs" />
    <Compile Include="..\runner\Services\StreamingTtsSpeaker.cs" Link="Runner\StreamingTtsSpeaker.cs" />
    <Compile Include="..\runner\Services\WhisperSpeechToTextService.cs" Link="Runner\WhisperSpeechToTextService.cs" />
    <Compile Include="..\runner\Services\WhisperModelManager.cs" Link="Runner\WhisperModelManager.cs" />
    <Compile Include="..\runner-cli\RunnerApiClient.cs" Link="RunnerCli\RunnerApiClient.cs" />
    <Compile Include="..\runner-cli\Repl.cs" Link="RunnerCli\Repl.cs" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!--
      RAG eval harness fixtures. Copied to the test output dir so
      RetrievalEvalHarness can resolve them at runtime under
      AppContext.BaseDirectory. Stays opt-in via FREEAI_TEST_OLLAMA_HOST
      env var (OllamaIntegrationFactAttribute).
    -->
    <None Include="Fixtures\RagCorpus\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Retrieval\baseline.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Retrieval\baseline.json')" />
  </ItemGroup>
</Project>
