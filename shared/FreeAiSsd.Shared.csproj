<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <!--
    The UI/Theme folder hosts WPF resource dictionaries and a developer
    preview Window. Those files are LINKED into prep-app and runner
    (which are WPF projects); this shared assembly is plain net8.0 and
    must not try to compile WPF types. Exclude them from the implicit
    SDK globs.
  -->
  <ItemGroup>
    <Compile Remove="UI\**\*.cs" />
    <None Remove="UI\**\*.xaml" />
    <None Include="UI\**\*.xaml" />
    <None Include="UI\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="UglyToad.PdfPig" Version="1.7.0-custom-5" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="SharpDX.DirectInput" Version="4.2.0" />
  </ItemGroup>
</Project>
