<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  ============================================================
          Free AI SSD — Neumorphic Dark Theme : Color Tokens

          All color tokens used across prep-app and runner. Anything
          color-related in the UI should resolve to one of these
          brushes. Raw hex literals in views are considered a smell.
          ============================================================  -->

    <!--  Raw Color values (kept separately so brushes can share)  -->

    <!-- Surfaces -->
    <Color x:Key="BgBaseColor">#FF1A1D24</Color>
    <Color x:Key="BgRaisedColor">#FF1F232C</Color>
    <Color x:Key="BgSunkenColor">#FF15181E</Color>
    <Color x:Key="BgElevatedColor">#FF252934</Color>

    <!-- Neumorphic light/dark edges (drive the raised vs sunken illusion).
         SurfaceShadow is the color Shadows.xaml uses for dark drops; kept as
         a token so PttOverlayWindow etc. can echo it via StaticResource. -->
    <Color x:Key="SurfaceShadowColor">#FF0B0D12</Color>
    <Color x:Key="SurfaceBorderColor">#FF222630</Color>

    <!-- Text.
         TextMutedColor is tuned to clear WCAG 2.1 AA 4.5:1 against every
         surface token (BgBase, BgRaised, BgSunken, BgElevated). Any darker
         and captions fall below contrast on BgElevated — don't regress. -->
    <Color x:Key="TextPrimaryColor">#FFEAEEF6</Color>
    <Color x:Key="TextSecondaryColor">#FFB6BDCC</Color>
    <Color x:Key="TextMutedColor">#FF8F95A8</Color>
    <Color x:Key="TextDisabledColor">#FF555A68</Color>

    <!-- Neon accents -->
    <Color x:Key="AccentCyanColor">#FF00E5FF</Color>
    <Color x:Key="AccentMagentaColor">#FFFF2D92</Color>
    <Color x:Key="AccentPurpleColor">#FF8A2BE2</Color>

    <!-- Status -->
    <Color x:Key="StatusSuccessColor">#FF4CE0B3</Color>
    <Color x:Key="StatusWarningColor">#FFFFB454</Color>
    <Color x:Key="StatusDangerColor">#FFFF4D6D</Color>
    <Color x:Key="StatusInfoColor">#FF5BC0FF</Color>

    <!--  SolidColorBrush tokens  -->

    <SolidColorBrush x:Key="BgBaseBrush"      Color="{StaticResource BgBaseColor}"/>
    <SolidColorBrush x:Key="BgRaisedBrush"    Color="{StaticResource BgRaisedColor}"/>
    <SolidColorBrush x:Key="BgSunkenBrush"    Color="{StaticResource BgSunkenColor}"/>
    <SolidColorBrush x:Key="BgElevatedBrush"  Color="{StaticResource BgElevatedColor}"/>

    <SolidColorBrush x:Key="SurfaceShadowBrush"    Color="{StaticResource SurfaceShadowColor}"/>
    <SolidColorBrush x:Key="SurfaceBorderBrush"    Color="{StaticResource SurfaceBorderColor}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush"     Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextDisabledBrush"  Color="{StaticResource TextDisabledColor}"/>

    <SolidColorBrush x:Key="AccentCyanBrush"    Color="{StaticResource AccentCyanColor}"/>
    <SolidColorBrush x:Key="AccentMagentaBrush" Color="{StaticResource AccentMagentaColor}"/>
    <SolidColorBrush x:Key="AccentPurpleBrush"  Color="{StaticResource AccentPurpleColor}"/>

    <SolidColorBrush x:Key="StatusSuccessBrush" Color="{StaticResource StatusSuccessColor}"/>
    <SolidColorBrush x:Key="StatusWarningBrush" Color="{StaticResource StatusWarningColor}"/>
    <SolidColorBrush x:Key="StatusDangerBrush"  Color="{StaticResource StatusDangerColor}"/>
    <SolidColorBrush x:Key="StatusInfoBrush"    Color="{StaticResource StatusInfoColor}"/>

    <!--  Neon gradient brushes  -->

    <!-- Primary accent: cyan → magenta. Use for primary action buttons,
         active tab indicators, headline glyphs. -->
    <LinearGradientBrush x:Key="NeonGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0.0" Color="{StaticResource AccentCyanColor}"/>
        <GradientStop Offset="1.0" Color="{StaticResource AccentMagentaColor}"/>
    </LinearGradientBrush>

    <!-- Hot accent: magenta → purple. Use for destructive / warning
         emphasis and brand flourish. -->
    <LinearGradientBrush x:Key="NeonHotGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0.0" Color="{StaticResource AccentMagentaColor}"/>
        <GradientStop Offset="1.0" Color="{StaticResource AccentPurpleColor}"/>
    </LinearGradientBrush>

    <!-- 1px focus border gradient (cyan → magenta → purple sweep). -->
    <LinearGradientBrush x:Key="FocusBorderGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0.0" Color="{StaticResource AccentCyanColor}"/>
        <GradientStop Offset="0.5" Color="{StaticResource AccentMagentaColor}"/>
        <GradientStop Offset="1.0" Color="{StaticResource AccentPurpleColor}"/>
    </LinearGradientBrush>

    <!-- Subtle neumorphic surface gradient: very gentle vertical sheen
         that helps sell the raised look without becoming skeuomorphic. -->
    <LinearGradientBrush x:Key="RaisedSurfaceGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#FF222732"/>
        <GradientStop Offset="1.0" Color="#FF1B1F28"/>
    </LinearGradientBrush>

    <!-- Inverse: sunken surface looks slightly darker at top. -->
    <LinearGradientBrush x:Key="SunkenSurfaceGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#FF14171D"/>
        <GradientStop Offset="1.0" Color="#FF181C23"/>
    </LinearGradientBrush>

</ResourceDictionary>
