<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  ============================================================
          Free AI SSD — Neumorphic Dark Theme : Drop Shadows

          Pairs of DropShadowEffect resources used to fake a single
          light source from the upper left.

          Raised surfaces:   apply RaisedHighlightShadow on a layer
                             behind/around, plus RaisedDarkShadow on
                             the surface itself (or stack two Borders).
          Sunken surfaces:   invert direction so darkness sits at the
                             upper-left lip and highlight at lower right.
          Focus glows:       outer color glow used together with the
                             FocusBorderGradientBrush from Colors.xaml.

          NOTE: WPF DropShadowEffect Direction is in degrees, measured
          counter-clockwise from the +X axis. 135° points to the upper
          left, 315° points to the lower right.
          ============================================================  -->

    <!--  Raised: light from upper left  -->

    <!-- Soft light bleed cast toward upper left. Pair with a Border that
         sits behind the surface, or set as the Effect on a child layer.
         Phase B (Mac-parity restyle): opacity dialled back from 0.85 to
         0.45 so the "light source" illusion reads as ambient depth, not
         a halo. -->
    <DropShadowEffect x:Key="RaisedHighlightShadow"
                      Color="#2A2F3A"
                      Direction="135"
                      ShadowDepth="6"
                      BlurRadius="14"
                      Opacity="0.45"
                      RenderingBias="Quality"/>

    <!-- Deep matte shadow falling toward lower right.
         Phase B (Mac-parity restyle): the dominant "raised surface" cue
         was reading as neon glow on dark backgrounds. Reduced depth
         6->3, blur 16->10, opacity 0.95->0.55 so raised surfaces sit
         calmly above the canvas (Mac-app feel) instead of floating. -->
    <DropShadowEffect x:Key="RaisedDarkShadow"
                      Color="#0B0D12"
                      Direction="315"
                      ShadowDepth="3"
                      BlurRadius="10"
                      Opacity="0.55"
                      RenderingBias="Quality"/>

    <!-- Tighter dark variant for small / subtle elements (chips, inline buttons).
         Phase B: opacity 0.9->0.55 to match the new RaisedDarkShadow. -->
    <DropShadowEffect x:Key="RaisedDarkShadowSmall"
                      Color="#0B0D12"
                      Direction="315"
                      ShadowDepth="3"
                      BlurRadius="8"
                      Opacity="0.55"
                      RenderingBias="Quality"/>

    <!--  Sunken: invert direction so the lip catches darkness  -->

    <DropShadowEffect x:Key="SunkenDarkShadow"
                      Color="#0B0D12"
                      Direction="135"
                      ShadowDepth="4"
                      BlurRadius="10"
                      Opacity="0.85"
                      RenderingBias="Quality"/>

    <!--  Focus glows (omnidirectional)  -->

    <!-- Phase B: opacity 0.85->0.55 so keyboard focus reads as a clear
         signal, not a halo. Still well above WCAG 2.1 focus-indicator
         contrast against the dark canvas. -->
    <DropShadowEffect x:Key="FocusGlowCyan"
                      Color="#00E5FF"
                      Direction="0"
                      ShadowDepth="0"
                      BlurRadius="14"
                      Opacity="0.55"
                      RenderingBias="Quality"/>

    <DropShadowEffect x:Key="FocusGlowMagenta"
                      Color="#FF2D92"
                      Direction="0"
                      ShadowDepth="0"
                      BlurRadius="14"
                      Opacity="0.85"
                      RenderingBias="Quality"/>

    <!-- Subtle ambient glow for hover states.
         Phase B: kept at 0.45 — already subtle enough; the louder
         FocusGlowCyan was the offender, this one is fine. -->
    <DropShadowEffect x:Key="HoverGlowCyan"
                      Color="#00E5FF"
                      Direction="0"
                      ShadowDepth="0"
                      BlurRadius="10"
                      Opacity="0.45"
                      RenderingBias="Quality"/>

</ResourceDictionary>
